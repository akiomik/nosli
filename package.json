{
  "name": "nosli",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --no-tsconfig",
    "check:watch": "svelte-kit sync && svelte-check --no-tsconfig --watch",
    "test": "npm run test:unit",
    "test:unit": "vitest",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "favicongen": "qlmanage -t -s 512 -o static static/favicon.svg && mv static/favicon.svg.png static/favicon.png",
    "touchicongen": "qlmanage -t -s 180 -o static static/favicon.svg && mv static/favicon.svg.png static/apple-touch-icon.png"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@skeletonlabs/skeleton": "^3.2.2",
    "@skeletonlabs/skeleton-svelte": "^1.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@sveltejs/adapter-vercel": "^5.10.3",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@tailwindcss/forms": "^0.5.10",
    "@types/node": "^22.20.5",
    "@types/sanitize-html": "^2.8.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.4.1",
    "typescript": "5.4.5",
    "vite": "^5.4.21",
    "vitest": "^1.6.1"
  },
  "type": "module",
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.3.0",
    "@fortawesome/free-solid-svg-icons": "^6.3.0",
    "@fortawesome/svelte-fontawesome": "^0.2.0",
    "@macfja/svelte-persistent-store": "^2.2.1",
    "@types/url-regex-safe": "^1.0.0",
    "linkify-html": "^4.1.0",
    "linkify-plugin-hashtag": "^4.1.0",
    "linkify-plugin-mention": "^4.1.0",
    "linkifyjs": "^4.3.2",
    "nostr-tools": "1.6.1",
    "re2": "^1.27.0",
    "rx-nostr": "^0.9.0",
    "sanitize-html": "^2.18.1",
    "svelte-i18n": "^4.0.1",
    "url-regex-safe": "^3.0.0"
  },
  "overrides": {
    "@scure/bip39": "1.1.1"
  }
}
