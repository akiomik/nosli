{
  "name": "nosli",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "postinstall": "node scripts/patch-vercel-adapter.mjs",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --no-tsconfig && node scripts/check-types.mjs",
    "check:ts": "svelte-kit sync && node scripts/check-types.mjs",
    "check:watch": "svelte-kit sync && svelte-check --no-tsconfig --watch",
    "test": "npm run test:unit",
    "test:unit": "vitest",
    "lint": "prettier --plugin-search-dir . --check . && ESLINT_USE_FLAT_CONFIG=false eslint .",
    "format": "prettier --plugin-search-dir . --write .",
    "favicongen": "qlmanage -t -s 512 -o static static/favicon.svg && mv static/favicon.svg.png static/favicon.png",
    "touchicongen": "qlmanage -t -s 180 -o static static/favicon.svg && mv static/favicon.svg.png static/apple-touch-icon.png"
  },
  "devDependencies": {
    "@skeletonlabs/skeleton": "^2.11.0",
    "@skeletonlabs/tw-plugin": "^0.4.1",
    "@sveltejs/adapter-vercel": "2.4.3",
    "@sveltejs/kit": "^1.30.4",
    "@tailwindcss/forms": "^0.5.3",
    "@types/node": "^22.20.5",
    "@types/sanitize-html": "^2.8.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "autoprefixer": "^10.4.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte3": "^4.0.0",
    "postcss": "^8.5.31",
    "postcss-load-config": "^4.0.1",
    "prettier": "^2.8.0",
    "prettier-plugin-svelte": "^2.8.1",
    "svelte": "^3.54.0",
    "svelte-check": "^3.0.1",
    "svelte-preprocess": "^5.1.4",
    "tailwindcss": "^3.1.5",
    "tslib": "^2.4.1",
    "typescript": "5.4.5",
    "vite": "^4.5.14",
    "vitest": "^0.34.6"
  },
  "type": "module",
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.3.0",
    "@fortawesome/free-solid-svg-icons": "^6.3.0",
    "@fortawesome/svelte-fontawesome": "^0.2.0",
    "@macfja/svelte-persistent-store": "^2.2.1",
    "@types/url-regex-safe": "^1.0.0",
    "linkify-html": "^4.1.0",
    "linkify-plugin-hashtag": "^4.1.0",
    "linkify-plugin-mention": "^4.1.0",
    "linkifyjs": "^4.3.2",
    "nostr-tools": "1.7.2",
    "re2": "^1.27.0",
    "rx-nostr": "^0.9.0",
    "sanitize-html": "^2.18.1",
    "svelte-i18n": "^3.6.0",
    "url-regex-safe": "^3.0.0"
  },
  "overrides": {
    "@scure/bip39": "1.1.1"
  }
}
